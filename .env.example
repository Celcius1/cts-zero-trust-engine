# ==============================================================================
# CEL-TECH-SERV ZERO TRUST ENGINE - ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================
# INSTRUCTIONS: Copy this file to '.env' and populate with your live production values.
# DO NOT commit your live '.env' file to version control.

# -- Core API Configuration --
API_PORT=8088
API_DOMAIN=your.domain.com
CORS_ORIGIN=https://your.domain.com

# -- PostgreSQL Database Configuration --
DB_PORT=5433
POSTGRES_USER=cts_admin
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=cts_engine_db

# -- WireGuard Configuration --
VPN_EXTERNAL_IP=vpn.yourdomain.com
VPN_SERVER_PUBKEY=insert_your_wireguard_public_key_here
VPN_TRUSTED_SUBNET_PREFIX=10.13.13.
VPN_JAIL_SUBNET_PREFIX=10.13.14.

# -- SMTP Engine --
SMTP_HOST=mail.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
